# Địa chỉ API của aives-backend (tuỳ chọn khi dev vì đã có Vite proxy sang http://localhost:8080)
# Khi deploy hoặc gọi qua tunnel/ngrok:
VITE_API_BASE_URL=

# Email hỗ trợ công khai (tuỳ chọn). Chỉ điền email chính thức của dự án.
# VITE_SUPPORT_EMAIL=hotro@example.com

# Google OAuth Client ID cho tính năng Đăng nhập bằng Google
VITE_GOOGLE_CLIENT_ID=
